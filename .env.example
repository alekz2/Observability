# ---------------------------------------------------------------------------
# Remote Query Service — environment template
# Copy to .env and fill in values for your environment.
# ---------------------------------------------------------------------------

# Path to the policy file (JSON). Supports ${ENV_VAR} substitution inside it.
REMOTE_QUERY_POLICY_PATH=config/policy.json

# Session lifetime in seconds (default: 30 minutes).
REMOTE_QUERY_SESSION_TTL_SECONDS=1800

# Maximum bytes read per SSH chunk (default: 64 KB). Used for initial/tail reads.
# Log search always scans the full file regardless of this limit.
REMOTE_QUERY_MAX_CHUNK_BYTES=65536

# Default number of lines returned per read (default: 200).
REMOTE_QUERY_DEFAULT_LINES=200

# ---------------------------------------------------------------------------
# SSH connection defaults
# Applied to any host policy that omits the corresponding field.
# You can also use ${REMOTE_QUERY_SSH_DEFAULT_USER} inside policy.json.
# ---------------------------------------------------------------------------
REMOTE_QUERY_SSH_DEFAULT_USER=
REMOTE_QUERY_SSH_DEFAULT_KEY_PATH=
# Path to a known_hosts file, or leave blank to disable host-key verification.
REMOTE_QUERY_SSH_DEFAULT_KNOWN_HOSTS=

# ---------------------------------------------------------------------------
# Output redaction — pipe-separated (||) regex patterns applied to all output.
# ---------------------------------------------------------------------------
REMOTE_QUERY_REDACT_PATTERNS=(?i)authorization:\s*bearer\s+\S+||(?i)api[_-]?key['\"]?\s*[:=]\s*['\"]?[A-Za-z0-9_\-]+

# ---------------------------------------------------------------------------
# Optional Redis URL for distributed session storage.
# Leave blank to use in-process memory (single instance only).
# ---------------------------------------------------------------------------
REMOTE_QUERY_REDIS_URL=

# ---------------------------------------------------------------------------
# Authentication — comma-separated list of token:subject pairs.
# Example: secrettoken1:alice,secrettoken2:bob
# Leave blank only for local development; never run unauthenticated in production.
# ---------------------------------------------------------------------------
REMOTE_QUERY_API_KEYS=

# ---------------------------------------------------------------------------
# Log paths — use relative paths (resolved from the working directory).
# ---------------------------------------------------------------------------
REMOTE_QUERY_ERROR_LOG_PATH=var/error.log
REMOTE_QUERY_AUDIT_LOG_PATH=var/audit.log
