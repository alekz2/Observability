        "read_splunkfwd_inputs": {
          "command": "cat",
          "args": ["/opt/splunkforwarder/etc/system/local/inputs.conf"],
          "description": "Read the forwarder inputs.conf (monitor stanzas)"
        },
        "read_splunkfwd_outputs": {
          "command": "cat",
          "args": ["/opt/splunkforwarder/etc/system/local/outputs.conf"],
          "description": "Read the forwarder outputs.conf (forward-server target)"
        }
      }
    },
    {
      "name": "Blackwidow",
      "address": "Blackwidow",
      "port": 22,
      "username": "${SSH_USER}",
      "private_key_path": "${SSH_KEY_PATH}",
      "known_hosts_path": null,
      "allowed_paths": [
        "/home/${SSH_USER}/observability-lgtm/alloy/*",
        "/home/${SSH_USER}/observability-lgtm/grafana/*",
        "/home/${SSH_USER}/observability-lgtm/grafana/provisioning/datasources/*",
        "/home/${SSH_USER}/observability-lgtm/loki/*",
        "/home/${SSH_USER}/observability-lgtm/mimir/*",
        "/home/${SSH_USER}/observability-lgtm/tempo/*",
        "/home/${SSH_USER}/observability-lgtm/docker-compose.yml"
      ],
      "query_services": [
        "filesystem_read"
      ],
      "allowed_queries": {
        "alloy_config": {
          "command": [
            "cat"
          ],
          "args": [
            "/home/${SSH_USER}/observability-lgtm/alloy/config.alloy"
          ],
          "description": "Read the Alloy config file from the observability-lgtm deployment"
        },
        "alloy_dir_list": {
          "command": [
            "find"
          ],
          "args": [
            "/home/${SSH_USER}/observability-lgtm/alloy",
            "-maxdepth",
            "1",
            "-type",
            "f"
          ],
          "description": "List Alloy files in the observability-lgtm alloy directory"
        },
        "docker_ps": {
          "command": [
            "docker"
          ],
          "args": [
            "ps",
            "--format",
            "{{.Names}} | {{.Image}} | {{.Status}} | {{.Ports}}"
          ],
          "description": "List running containers with image, status, and port bindings"
        },
        "docker_inspect_grafana": {
          "command": [
            "docker"
          ],
          "args": [
            "inspect",
            "grafana",
            "--format",
            "{{json .Mounts}}"
          ],
          "description": "Show Grafana container mount paths as JSON"
        },
        "docker_inspect_loki": {
          "command": [
            "docker"
          ],
          "args": [
            "inspect",
            "loki",
            "--format",
            "{{json .Mounts}}"
          ],
          "description": "Show Loki container mount paths as JSON"
        },
        "docker_inspect_mimir": {
          "command": [
            "docker"
          ],
          "args": [
            "inspect",
            "mimir",
            "--format",
            "{{json .Mounts}}"
          ],
          "description": "Show Mimir container mount paths as JSON"
        },
        "docker_inspect_tempo": {
          "command": [
            "docker"
          ],
          "args": [
            "inspect",
            "tempo",
            "--format",
            "{{json .Mounts}}"
          ],
          "description": "Show Tempo container mount paths as JSON"
        },
        "docker_inspect_alloy": {
          "command": [
            "docker"
          ],
          "args": [
            "inspect",
            "alloy",
            "--format",
            "{{json .Mounts}}"
          ],
          "description": "Show Alloy container mount paths as JSON"
        },
        "find_lgtm_all": {
          "command": [
            "find"
          ],
          "args": [
            "/home/${SSH_USER}/observability-lgtm",
            "-type",
            "f",
            "-not",
            "-path",
            "*/wal/*",
            "-not",
            "-path",
            "*/blocks/*",
            "-not",
            "-path",
            "*/chunks/*",
            "-not",
            "-path",
            "*/data/*"
          ],
          "description": "List all config files under the LGTM stack directory, excluding storage and WAL paths"
        },
        "read_docker_compose": {
          "command": [
            "cat"
          ],
          "args": [
            "/home/${SSH_USER}/observability-lgtm/docker-compose.yml"
          ],
          "description": "Read the Docker Compose file for the LGTM stack"
        },
        "read_grafana_datasources": {
          "command": [
            "cat"
          ],
          "args": [
            "/home/${SSH_USER}/observability-lgtm/grafana/provisioning/datasources/datasources.yaml"
          ],
          "description": "Read Grafana provisioned data source definitions"
        },
        "read_mimir_config": {
          "command": [
            "cat"
          ],
          "args": [
            "/home/${SSH_USER}/observability-lgtm/mimir/mimir.yaml"
          ],
          "description": "Read the Mimir configuration file"
        }
      }
