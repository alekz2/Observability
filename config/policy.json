    {
      "name": "Hawkeye",
      "address": "192.168.0.154",
      "port": 22,
      "username": "${SSH_USER}",
      "private_key_path": "${SSH_KEY_PATH}",
      "known_hosts_path": null,
      "allowed_paths": [
        "/opt/splunk/etc/system/local/*.conf",
        "/opt/splunk/var/log/splunk/*.log"
      ],
      "query_services": [
        "host_identity",
        "process_observability",
        "network_diagnostics"
      ],
      "allowed_queries": {
        "splunk_version": {
          "command": "/opt/splunk/bin/splunk",
          "args": ["version"],
          "description": "Show Splunk Enterprise version"
        },
        "splunk_status": {
          "command": "/opt/splunk/bin/splunk",
          "args": ["status"],
          "description": "Show splunkd process status via PID file check"
        },
        "list_splunk_local_configs": {
          "command": "find",
          "args": [
            "/opt/splunk/etc/system/local",
            "-maxdepth", "1",
            "-name", "*.conf",
            "-printf", "%f\n"
          ],
          "description": "List config files present in Splunk system/local/"
        },
        "read_splunk_inputs": {
          "command": "cat",
          "args": ["/opt/splunk/etc/system/local/inputs.conf"],
          "description": "Read inputs.conf (monitor and scripted input stanzas)"
        },
        "read_splunk_outputs": {
          "command": "cat",
          "args": ["/opt/splunk/etc/system/local/outputs.conf"],
          "description": "Read outputs.conf (indexer routing and load balancing)"
        },
        "read_splunk_indexes": {
          "command": "cat",
          "args": ["/opt/splunk/etc/system/local/indexes.conf"],
          "description": "Read indexes.conf (index definitions, paths, retention)"
        },
        "read_splunk_server": {
          "command": "cat",
          "args": ["/opt/splunk/etc/system/local/server.conf"],
          "description": "Read server.conf (server name, license, general settings)"
        },
        "read_splunk_props": {
          "command": "cat",
          "args": ["/opt/splunk/etc/system/local/props.conf"],
          "description": "Read props.conf (sourcetype timestamp and linemerge rules)"
        },
        "read_splunk_transforms": {
          "command": "cat",
          "args": ["/opt/splunk/etc/system/local/transforms.conf"],
          "description": "Read transforms.conf (field extractions, lookup definitions)"
        },
        "splunk_log_tail": {
          "command": "tail",
          "args": ["-n", "100", "/opt/splunk/var/log/splunk/splunkd.log"],
          "description": "Show the last 100 lines of splunkd.log"
        },
        "splunk_license_log": {
          "command": "tail",
          "args": ["-n", "50", "/opt/splunk/var/log/splunk/license_usage.log"],
          "description": "Show recent license usage log entries"
        }
      }
    },
    {
      "name": "Falcon",
      "address": "Falcon",
      "port": 22,
      "username": "${SSH_USER}",
      "private_key_path": "${SSH_KEY_PATH}",
      "known_hosts_path": null,
      "allowed_paths": [
        "/home/${SSH_USER}/Work/quickfixj/**",
        "/home/${SSH_USER}/Work/fix-lab/**"
      ],
      "query_services": [
        "host_identity",
        "process_observability",
        "network_diagnostics",
        "filesystem_read"
      ],
      "allowed_queries": {
        "read_executor_cfg": {
          "command": "cat",
          "args": [
            "/home/${SSH_USER}/Work/quickfixj/quickfixj-examples/executor/src/main/resources/quickfix/examples/executor/executor.cfg"
          ],
          "description": "Read the QuickFIX/J executor acceptor configuration"
        },
        "list_executor_target": {
          "command": "find",
          "args": [
            "/home/${SSH_USER}/Work/quickfixj/quickfixj-examples/executor/target",
            "-maxdepth", "1",
            "-name", "*.jar",
            "-printf", "%f %k KB\n"
          ],
          "description": "List built executor JAR artifacts in the target directory"
        },
        "list_fix_session_files": {
          "command": "find",
          "args": [
            "/home/${SSH_USER}/Work/quickfixj/quickfixj-examples/executor/target/data/executor",
            "-maxdepth", "2",
            "-type", "f",
            "-printf", "%p\n"
          ],
          "description": "List QuickFIX/J session store files written by the executor"
        },
        "java_version": {
          "command": "java",
          "args": ["-version"],
          "description": "Show the active Java version on PATH"
        }
      }
    },
    {
      "name": "Thor",
      "address": "Thor",
      "os_family": "windows",
      "port": 22,
      "username": "${SSH_USER}",
      "private_key_path": "${SSH_KEY_PATH}",
      "known_hosts_path": null,
      "allowed_paths": [
        "C:/Users/${WIN_HOME_USER}/.ssh/*"
      ],
      "allowed_queries": {
        "hostname_short": {
          "command": [
            "powershell.exe",
            "-NoProfile",
            "-NonInteractive",
            "-Command"
          ],
          "args": [
            "$env:COMPUTERNAME"
          ],
          "description": "Show the Windows short hostname"
        },
        "portproxy_show_all": {
          "command": [
            "netsh",
            "interface",
            "portproxy",
            "show",
            "all"
          ],
          "description": "Show the configured Windows portproxy rules"
        },
        "openssh_service": {
          "command": [
            "powershell.exe",
            "-NoProfile",
            "-NonInteractive",
            "-Command"
          ],
          "args": [
            "Get-Service -Name sshd | Select-Object Name,Status,StartType | ConvertTo-Json -Compress"
          ],
          "description": "Show the OpenSSH service state"
        },
        "ssh_listeners": {
          "command": [
            "powershell.exe",
            "-NoProfile",
            "-NonInteractive",
            "-Command"
          ],
          "args": [
            "Get-NetTCPConnection -State Listen | Where-Object { $_.LocalPort -in 22,50022,60022 } | Sort-Object LocalPort | Select-Object LocalAddress,LocalPort,OwningProcess,State | ConvertTo-Json -Compress"
          ],
          "description": "Show Windows listeners for SSH and the WSL forwarded ports"
        },
        "relay_processes": {
          "command": [
            "powershell.exe",
            "-NoProfile",
            "-NonInteractive",
            "-Command"
          ],
          "args": [
            "Get-Process -Name sshd,wslrelay -ErrorAction SilentlyContinue | Select-Object Name,Id,Path | ConvertTo-Json -Compress"
          ],
          "description": "Show the SSH and WSL relay processes when present"
        },
        "firewall_ssh_rules": {
          "command": [
            "powershell.exe",
            "-NoProfile",
            "-NonInteractive",
            "-Command"
          ],
          "args": [
            "Get-NetFirewallRule | Where-Object { $_.DisplayName -like '*SSH*' -or $_.DisplayName -like '*50022*' -or $_.DisplayName -like '*60022*' } | Select-Object DisplayName,Enabled,Direction,Action | ConvertTo-Json -Compress"
          ],
          "description": "Show firewall rules relevant to SSH and the forwarded WSL ports"
        },
        "wsl_status": {
          "command": [
            "wsl.exe",
            "--status"
          ],
          "description": "Show the host WSL status"
        },
        "wsl_list": {
          "command": [
            "wsl.exe",
            "-l",
            "-v"
          ],
          "description": "List WSL distributions and their runtime state"
        },
        "vision_loopback_ssh_banner": {
          "command": [
            "powershell.exe",
            "-NoProfile",
            "-NonInteractive",
            "-Command"
          ],
          "args": [
            "$client = [System.Net.Sockets.TcpClient]::new(); $client.ReceiveTimeout = 3000; $client.SendTimeout = 3000; $client.Connect('127.0.0.1',50022); try { $stream = $client.GetStream(); $buffer = New-Object byte[] 256; $read = $stream.Read($buffer,0,$buffer.Length); [System.Text.Encoding]::ASCII.GetString($buffer,0,$read) } finally { $client.Dispose() }"
          ],
          "description": "Read the SSH banner from the Vision loopback relay on Thor"
        },
        "warmachine_loopback_ssh_banner": {
          "command": [
            "powershell.exe",
            "-NoProfile",
            "-NonInteractive",
            "-Command"
          ],
          "args": [
            "$client = [System.Net.Sockets.TcpClient]::new(); $client.ReceiveTimeout = 3000; $client.SendTimeout = 3000; $client.Connect('127.0.0.1',60022); try { $stream = $client.GetStream(); $buffer = New-Object byte[] 256; $read = $stream.Read($buffer,0,$buffer.Length); [System.Text.Encoding]::ASCII.GetString($buffer,0,$read) } finally { $client.Dispose() }"
          ],
          "description": "Read the SSH banner from the Warmachine loopback relay on Thor"
        },
        "vision_wsl_sshd_state": {
          "command": [
            "wsl.exe",
            "-d",
            "Vision",
            "--",
            "sh",
            "-lc"
          ],
          "args": [
            "hostname; ps -ef | grep [s]shd; ss -ltnp | grep ':22 ' || true"
          ],
          "description": "Inspect the Vision WSL distro for sshd processes and port 22 listeners"
        },
        "vision_wsl_listeners": {
          "command": [
            "wsl.exe",
            "-d",
            "Vision",
            "--",
            "sh",
            "-lc"
          ],
          "args": [
            "hostname; ss -ltnp"
          ],
          "description": "List listening TCP sockets inside the Vision WSL distro"
        },
        "warmachine_wsl_sshd_state": {
          "command": [
            "wsl.exe",
            "-d",
            "Warmachine",
            "--",
            "sh",
            "-lc"
          ],
          "args": [
            "hostname; ps -ef | grep [s]shd; ss -ltnp | grep ':22 ' || true"
          ],
          "description": "Inspect the Warmachine WSL distro for sshd processes and port 22 listeners"
        },
        "warmachine_wsl_listeners": {
          "command": [
            "wsl.exe",
            "-d",
            "Warmachine",
            "--",
            "sh",
            "-lc"
          ],
          "args": [
            "hostname; ss -ltnp"
          ],
          "description": "List listening TCP sockets inside the Warmachine WSL distro"
        }
      }
    }
  ]
}
