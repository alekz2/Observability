{
  "query_services": {
    "host_identity": {
      "description": "Basic host identity checks",
      "queries": {
        "hostname_short": {
          "command": "hostname",
          "args": [],
          "description": "Show the short hostname"
        },
        "hostname_fqdn": {
          "command": "hostname",
          "args": [
            "-f"
          ],
          "description": "Show the fully qualified hostname"
        }
      }
    },
    "process_observability": {
      "description": "Process inspection queries",
      "queries": {
        "ps_named": {
          "command": "pgrep",
          "args": [
            "-a",
            "-f",
            "{process_name}"
          ],
          "description": "List processes whose full command line matches a pattern",
          "arg_policies": [
            {
              "name": "process_name",
              "pattern": "[A-Za-z0-9_.-]+",
              "required": true
            }
          ]
        },
        "free_mem": {
          "command": "free",
          "args": [
            "-h"
          ],
          "description": "Show memory usage summary (total, used, free, available, swap)"
        },
        "ps_mem": {
          "command": "ps",
          "args": [
            "aux",
            "--sort=-%mem"
          ],
          "description": "List all processes sorted by memory usage (RSS descending)"
        }
      }
    },
    "network_diagnostics": {
      "description": "Network and firewall diagnostics",
      "queries": {
        "ss_listen": {
          "command": "ss",
          "args": [
            "-ltnp"
          ],
          "description": "Show listening TCP sockets"
        },
        "nmcli_device_status": {
          "command": "nmcli",
          "args": [
            "device",
            "show",
            "{device_name}"
          ],
          "description": "Show NetworkManager device details",
          "arg_policies": [
            {
              "name": "device_name",
              "pattern": "[A-Za-z0-9_.:-]+",
              "required": true
            }
          ]
        },
        "getent_hosts": {
          "command": "getent",
          "args": [
            "hosts",
            "{name}"
          ],
          "description": "Resolve a host name through NSS",
          "arg_policies": [
            {
              "name": "name",
              "pattern": "[A-Za-z0-9_.:-]+",
              "required": true
            }
          ]
        },
        "getent_ahostsv4": {
          "command": "getent",
          "args": [
            "ahostsv4",
            "{name}"
          ],
          "description": "Resolve IPv4 addresses for a host name through NSS",
          "arg_policies": [
            {
              "name": "name",
              "pattern": "[A-Za-z0-9_.:-]+",
              "required": true
            }
          ]
        },
        "ip_addr": {
          "command": "ip",
          "args": [
            "-brief",
            "addr"
          ],
          "description": "Show interface addresses"
        },
        "ip_route": {
          "command": "ip",
          "args": [
            "route"
          ],
          "description": "Show routing table"
        },
        "ping_host": {
          "command": "ping",
          "args": [
            "-c",
            "2",
            "-W",
            "2",
            "{name}"
          ],
          "description": "Ping a host with bounded count and timeout",
          "arg_policies": [
            {
              "name": "name",
              "pattern": "[A-Za-z0-9_.:-]+",
              "required": true
            }
          ]
        },
        "tcp_connect_check": {
          "command": "nc",
          "args": [
            "-zv",
            "-w",
            "3",
            "{name}",
            "{port}"
          ],
          "description": "Check TCP connectivity to a host and port",
          "arg_policies": [
            {
              "name": "name",
              "pattern": "[A-Za-z0-9_.:-]+",
              "required": true
            },
            {
              "name": "port",
              "pattern": "[0-9]{1,5}",
              "required": true
            }
          ]
        },
        "firewalld_state": {
          "command": [
            "sudo",
            "firewall-cmd"
          ],
          "args": [
            "--state"
          ],
          "description": "Show firewalld state"
        },
        "firewalld_ports": {
          "command": [
            "sudo",
            "firewall-cmd"
          ],
          "args": [
            "--list-ports"
          ],
          "description": "List firewalld open ports"
        },
        "firewalld_services": {
          "command": [
            "sudo",
            "firewall-cmd"
          ],
          "args": [
            "--list-services"
          ],
          "description": "List firewalld enabled services"
        },
        "iptables_input": {
          "command": [
            "sudo",
            "iptables"
          ],
          "args": [
            "-S",
            "INPUT"
          ],
          "description": "Show iptables INPUT chain rules"
        },
        "nft_ruleset": {
          "command": [
            "sudo",
            "nft"
          ],
          "args": [
            "list",
            "ruleset"
          ],
          "description": "Show nftables ruleset"
        }
      }
    },
    "filesystem_read": {
      "description": "Read-only filesystem queries",
      "queries": {
        "alloy_config": {
          "command": [
            "sudo",
            "cat"
          ],
          "args": [
            "/etc/alloy/config.alloy"
          ],
          "description": "Read the Alloy config file"
        }
      }
    },
    "geode_diagnostics": {
      "description": "Apache Geode-specific diagnostics",
      "queries": {
        "curl_geode_ping": {
          "command": "curl",
          "args": [
            "-i",
            "-s",
            "http://{name}:{port}/geode/v1/ping"
          ],
          "description": "Check the Geode REST ping endpoint",
          "arg_policies": [
            {
              "name": "name",
              "pattern": "[A-Za-z0-9_.:-]+",
              "required": true
            },
            {
              "name": "port",
              "pattern": "[0-9]{1,5}",
              "required": true
            }
          ]
        },
        "ss_geode": {
          "command": "ss",
          "args": [
            "-ltnp"
          ],
          "description": "Show listening sockets for Geode-related ports"
        }
      }
    },
    "neovim_introspection": {
      "description": "Read-only Neovim and Mason installation introspection",
      "queries": {
        "nvim_version": {
          "command": "nvim",
          "args": [
            "--version"
          ],
          "description": "Show the installed Neovim version and build information"
        },
        "nvim_stdpaths": {
          "command": "nvim",
          "args": [
            "--headless",
            "--clean",
            "+lua print(vim.json.encode({config=vim.fn.stdpath('config'),data=vim.fn.stdpath('data'),state=vim.fn.stdpath('state'),cache=vim.fn.stdpath('cache')}))",
            "+qa"
          ],
          "description": "Show Neovim standard config, data, state, and cache paths"
        },
        "nvim_pack_get": {
          "command": "nvim",
          "args": [
            "--headless",
            "--clean",
            "+lua local ok,items=pcall(function() return vim.pack.get(nil,{offline=true}) end); if ok then print(vim.json.encode(items)) else print('vim.pack unavailable') end",
            "+qa"
          ],
          "description": "List plugins managed by Neovim's native vim.pack package manager"
        },
        "nvim_dap_python_probe": {
          "command": "sh",
          "args": [
            "-lc",
            "set -u; data=\"$HOME/.local/share/nvim\"; echo \"nvim=$(command -v nvim || true)\"; echo \"python=$(command -v python || true)\"; echo \"python3=$(command -v python3 || true)\"; echo \"debugpy_pkg=$data/mason/packages/debugpy\"; ls -la \"$data/mason/packages/debugpy\" 2>&1 || true; ls -la \"$data/mason/packages/debugpy/venv/bin\" 2>&1 || true; echo \"debugpy-adapter-bin=$data/mason/bin/debugpy-adapter\"; \"$data/mason/bin/debugpy-adapter\" --help 2>&1 | head -20 || true; echo \"venv-python-debugpy-adapter\"; \"$data/mason/packages/debugpy/venv/bin/python\" -m debugpy.adapter --help 2>&1 | head -20 || true"
          ],
          "description": "Probe Mason debugpy executable layout and adapter startup behavior"
        },
        "nvim_dap_runtime_probe": {
          "command": "nvim",
          "args": [
            "--headless",
            "+lua local ok, dap = pcall(require, 'dap'); print('dap_require=' .. tostring(ok)); if ok then print('adapter_python_type=' .. type(dap.adapters.python)); print('config_python_type=' .. type(dap.configurations.python)); print('config_python_count=' .. tostring(dap.configurations.python and #dap.configurations.python or 0)); if dap.configurations.python then for i,c in ipairs(dap.configurations.python) do print(i .. ':' .. tostring(c.name) .. ':' .. tostring(c.type) .. ':' .. tostring(c.request)) end end end",
            "+qa"
          ],
          "description": "Probe loaded nvim-dap Python adapter and configuration state"
        },
        "nvim_dap_logs": {
          "command": "sh",
          "args": [
            "-lc",
            "for f in \"$HOME/.cache/nvim/dap.log\" \"$HOME/.local/state/nvim/dap.log\" \"$HOME/.local/state/nvim/log\" \"$HOME/.local/state/nvim/nvim.log\"; do echo \"== $f ==\"; if [ -f \"$f\" ]; then tail -120 \"$f\"; else echo missing; fi; done"
          ],
          "description": "Read recent Neovim and nvim-dap log output from standard state/cache locations"
        },
        "nvim_config_files": {
          "command": "find",
          "args": [
            "/home/${SSH_USER}/.config/nvim",
            "-maxdepth",
            "4",
            "-type",
            "f",
            "-not",
            "-path",
            "*/.git/*",
            "-printf",
            "%p\n"
          ],
          "description": "List Neovim configuration files under ~/.config/nvim"
        },
        "nvim_lua_dirs": {
          "command": "find",
          "args": [
            "/home/${SSH_USER}/.config/nvim/lua",
            "-type",
            "d",
            "-not",
            "-path",
            "*/.git/*",
            "-printf",
            "%p\n"
          ],
          "description": "List Neovim Lua configuration directories under ~/.config/nvim/lua"
        },
        "nvim_lua_files": {
          "command": "find",
          "args": [
            "/home/${SSH_USER}/.config/nvim/lua",
            "-type",
            "f",
            "-not",
            "-path",
            "*/.git/*",
            "-printf",
            "%p\n"
          ],
          "description": "List Neovim Lua configuration files under ~/.config/nvim/lua"
        },
        "nvim_read_lua_file": {
          "command": "cat",
          "args": [
            "/home/${SSH_USER}/.config/nvim/lua/{lua_path}"
          ],
          "description": "Read a Lua configuration file under ~/.config/nvim/lua by relative path",
          "arg_policies": [
            {
              "name": "lua_path",
              "pattern": "([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*",
              "required": true
            }
          ]
        },
        "nvim_read_init_lua": {
          "command": "cat",
          "args": [
            "/home/${SSH_USER}/.config/nvim/init.lua"
          ],
          "description": "Read ~/.config/nvim/init.lua"
        },
        "nvim_read_init_vim": {
          "command": "cat",
          "args": [
            "/home/${SSH_USER}/.config/nvim/init.vim"
          ],
          "description": "Read ~/.config/nvim/init.vim"
        },
        "nvim_read_pack_lock": {
          "command": "cat",
          "args": [
            "/home/${SSH_USER}/.config/nvim/nvim-pack-lock.json"
          ],
          "description": "Read the native vim.pack lockfile"
        },
        "mason_package_dirs": {
          "command": "find",
          "args": [
            "/home/${SSH_USER}/.local/share/nvim/mason/packages",
            "-mindepth",
            "1",
            "-maxdepth",
            "1",
            "-type",
            "d",
            "-printf",
            "%f\n"
          ],
          "description": "List Mason package directories"
        },
        "mason_bin_links": {
          "command": "find",
          "args": [
            "/home/${SSH_USER}/.local/share/nvim/mason/bin",
            "-mindepth",
            "1",
            "-maxdepth",
            "1",
            "-printf",
            "%f -> %l\n"
          ],
          "description": "List Mason bin entries and symlink targets"
        },
        "mason_registry_dirs": {
          "command": "find",
          "args": [
            "/home/${SSH_USER}/.local/share/nvim/mason/registries",
            "-mindepth",
            "1",
            "-maxdepth",
            "3",
            "-type",
            "d",
            "-printf",
            "%p\n"
          ],
          "description": "List Mason registry directories"
        }
      }
    }
  },
  "hosts": [
    {
      "name": "Apache_Geode",
      "address": "Antman",
      "port": 22,
      "username": "${SSH_USER}",
      "private_key_path": "${SSH_KEY_PATH}",
      "known_hosts_path": null,
      "allowed_paths": [
        "/var/log/app/*.log",
        "/var/log/nginx/access.log",
        "/home/${SSH_USER}/geode_cluster/*.properties",
        "/home/${SSH_USER}/geode_cluster/server1/*.log",
        "/home/${SSH_USER}/geode_cluster/locator1/*.log"
      ],
      "query_services": [
        "host_identity",
        "process_observability",
        "network_diagnostics",
        "filesystem_read",
        "geode_diagnostics"
      ],
      "allowed_queries": {}
    },
    {
      "name": "Apache_Geode_Hulk",
      "address": "Hulk",
      "port": 22,
      "username": "${SSH_USER}",
      "private_key_path": "${SSH_KEY_PATH}",
      "known_hosts_path": null,
      "allowed_paths": [
        "/var/log/app/*.log",
        "/var/log/nginx/access.log",
        "/home/${SSH_USER}/geode_cluster/server2/*.log",
        "/home/${SSH_USER}/geode_cluster/locator2/*.log",
        "/home/${SSH_USER}/geode/scripts/*.sh",
        "/home/${SSH_USER}/.config/nvim/lua/*",
        "/home/${SSH_USER}/.config/nvim/lua/**",
